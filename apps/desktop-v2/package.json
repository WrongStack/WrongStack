{
  "name": "@wrongstack/desktop-v2",
  "version": "1.5.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Tauri desktop operations console for WrongStack projects and persistent sessions.",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "dev": "bun scripts/launch.ts dev",
    "dev:web": "bun scripts/sync-brand.ts && bun --bun run vite --host 127.0.0.1",
    "build": "bun scripts/sync-brand.ts && bun --bun run vite build",
    "build:native": "bun scripts/launch.ts build",
    "build:engine": "bun scripts/build-engine.mjs",
    "typecheck": "bun ../../scripts/bun-typecheck.mjs --noEmit",
    "test": "bun --bun run vitest run --config vitest.config.ts",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "test:native-ui": "bun tests/native-smoke.mjs",
    "test:engine-concurrency": "bun tests/engine-concurrency.mjs",
    "check:native": "cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@monaco-editor/react": "4.7.0",
    "@tauri-apps/api": "2.12.4",
    "@wrongstack/contracts": "workspace:*",
    "@wrongstack/core": "workspace:*",
    "@wrongstack/kanban": "workspace:*",
    "@wrongstack/plugins": "workspace:*",
    "@wrongstack/project-surfaces": "workspace:*",
    "@wrongstack/webui-protocol": "workspace:*",
    "@wrongstack/webui-server": "workspace:*",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "12.12.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "26.7.2",
    "i18next-resources-to-backend": "1.2.4",
    "lucide-react": "1.69.0",
    "monaco-editor": "0.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.13",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "virtua": "0.54.2",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@wrongstack/chronicle": "workspace:*",
    "tailwindcss": "4.3.4",
    "typescript": "^7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
