{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WrongStack Desktop v2",
  "version": "1.7.23",
  "identifier": "com.wrongstack.desktop.v2",
  "build": {
    "beforeDevCommand": "bun run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WrongStack — Mission Control",
        "width": 1480,
        "height": 960,
        "minWidth": 800,
        "dragDropEnabled": false,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src blob:; object-src 'none'; base-uri 'self'",
      "capabilities": ["shell", "windows-titlebar"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1QUEwQzE1MUJFQjc2MDUKUldRRmR1c2JGUXlxcFV4Q2crY0dLTjJhOWdMZEswZmZ2aE1pWVB0M0gyVnQzbis4ZG1zQjdtRmsK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/WrongStack/WrongStack/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
