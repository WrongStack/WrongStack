{
  "identifier": "shell",
  "description": "Desktop application windows own the host capability. Untrusted preview windows receive none.",
  "local": true,
  "windows": ["main", "project-*"],
  "permissions": [
    "core:default",
    "core:webview:allow-set-webview-zoom",
    "allow-host-request",
    "allow-choose-project",
    "allow-open-preview",
    "allow-open-external",
    "allow-terminal-stream",
    "allow-terminal-stop",
    "allow-terminal-ack",
    "allow-speech-status",
    "allow-speech-start",
    "allow-speech-stop",
    "allow-open-project-window"
  ]
}
