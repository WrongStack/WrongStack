{
  "name": "@wrongstack/desktop",
  "version": "1.0.37",
  "license": "MIT",
  "description": "WrongStack Desktop - Electron shell for managing multiple local WrongStack runtimes.",
  "author": "WrongStack contributors",
  "keywords": [
    "wrongstack",
    "desktop",
    "electron",
    "ai",
    "coding-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WrongStack/WrongStack.git",
    "directory": "apps/desktop"
  },
  "homepage": "https://github.com/WrongStack/WrongStack#readme",
  "bugs": {
    "url": "https://github.com/WrongStack/WrongStack/issues"
  },
  "type": "module",
  "main": "./dist/main/main.js",
  "bin": {
    "wrongstack-desktop": "./bin/wrongstack-desktop.js",
    "wstack-desktop": "./bin/wrongstack-desktop.js"
  },
  "files": [
    "assets",
    "bin",
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "bun ../../scripts/build.mjs --target @wrongstack/webui --skip-if-workspace-build && bun ../../scripts/build-package.mjs && bun --bun run vite build",
    "dev": "bun run build && electron .",
    "start": "electron .",
    "test": "bun --bun run vitest run --config vitest.config.ts",
    "test:coverage": "bun ../../scripts/coverage-lock.mjs bun ../../scripts/run-vitest-coverage.mjs run --coverage --config vitest.config.ts",
    "typecheck": "bun ../../scripts/bun-typecheck.mjs --noEmit",
    "package": "bun ../../scripts/package-desktop.mjs",
    "package:dir": "bun ../../scripts/package-desktop.mjs --dir",
    "clean": "bun -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@wrongstack/core": "workspace:*",
    "@wrongstack/webui": "workspace:*",
    "@wrongstack/webui-protocol": "workspace:*",
    "@wrongstack/webui-server": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.21.3",
    "zod": "^4.6.2"
  },
  "peerDependencies": {
    "electron": "^44.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
