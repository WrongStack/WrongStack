{
  "name": "@wrongstack/desktop",
  "version": "0.313.1",
  "license": "MIT",
  "description": "WrongStack Desktop - Electron shell for managing multiple local WrongStack runtimes.",
  "keywords": [
    "wrongstack",
    "desktop",
    "electron",
    "ai",
    "coding-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WrongStack/WrongStack.git",
    "directory": "apps/desktop"
  },
  "homepage": "https://github.com/WrongStack/WrongStack#readme",
  "bugs": {
    "url": "https://github.com/WrongStack/WrongStack/issues"
  },
  "type": "module",
  "main": "./dist/main/main.js",
  "bin": {
    "wrongstack-desktop": "./bin/wrongstack-desktop.js",
    "wstack-desktop": "./bin/wrongstack-desktop.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs --target @wrongstack/webui --skip-if-workspace-build && node ../../scripts/build-package.mjs && vite build",
    "dev": "pnpm run build && electron .",
    "start": "electron .",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "node ../../scripts/coverage-lock.mjs node ../../scripts/run-vitest-coverage.mjs run --coverage --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@wrongstack/core": "workspace:*",
    "@wrongstack/webui": "workspace:*",
    "@wrongstack/webui-protocol": "workspace:*",
    "@wrongstack/webui-server": "workspace:*",
    "electron": "^43.4.1",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
