{
  "name": "wrongstack",
  "version": "1.0.37",
  "license": "MIT",
  "description": "WrongStack — terminal AI coding agent. Installs `wrongstack` and `wstack` binaries (re-export of @wrongstack/cli).",
  "keywords": [
    "ai",
    "agent",
    "cli",
    "llm",
    "coding-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WrongStack/WrongStack.git",
    "directory": "apps/wrongstack"
  },
  "homepage": "https://github.com/WrongStack/WrongStack#readme",
  "bugs": "https://github.com/WrongStack/WrongStack/issues",
  "author": "ECOSTACK TECHNOLOGY OÜ",
  "type": "module",
  "bin": {
    "wstack": "./dist/index.js",
    "wrongstack": "./dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "bun --bun run tsc -p tsconfig.build.json",
    "typecheck": "bun ../../scripts/bun-typecheck.mjs -p tsconfig.tests.json",
    "test": "bun --bun run vitest run"
  },
  "dependencies": {
    "@wrongstack/cli": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
