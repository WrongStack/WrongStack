{
  "name": "wrongstack-monorepo",
  "private": true,
  "version": "0.296.3",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.5.3+sha512.7ac1c919341c213a34dc0d02afb7143c5c26ac26ee8c4782deea821b8ac64d2134a081fd8941dae6e29bbb48f58dfc2b7fbceeccc07cb2f09d219d342a4969ed",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "desktop": "pnpm --filter @wrongstack/desktop dev",
    "desktop:start": "pnpm --filter @wrongstack/desktop start",
    "test": "vitest run && pnpm --filter webui test",
    "test:watch": "vitest",
    "bench": "vitest bench --run --config vitest.bench.config.ts",
    "bench:perf": "node scripts/bench.mjs",
    "bench:tui-heap": "node scripts/tui-heap-soak.mjs",
    "brain:workload": "node scripts/brain-workload-report.mjs",
    "test:coverage": "node scripts/coverage-lock.mjs node scripts/test-coverage.mjs",
    "test:coverage:root": "node scripts/coverage-lock.mjs cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest run --coverage",
    "test:coverage:scripts": "node scripts/coverage-lock.mjs vitest run --config vitest.scripts.config.ts --coverage",
    "test:e2e": "playwright test",
    "lint": "biome lint .",
    "lint:distributive": "node scripts/lint-distributive-types.mjs",
    "lint:console": "node scripts/lint-console-logging.mjs --all",
    "lint:i18n": "node scripts/check-i18n-completeness.mjs",
    "format": "biome format --write .",
    "typecheck": "cross-env NODE_OPTIONS=--max-old-space-size=4096 pnpm -r --workspace-concurrency=1 typecheck",
    "clean": "pnpm -r --parallel clean && node -e \"require('node:fs').rmSync('node_modules',{recursive:true,force:true})\"",
    "version:patch": "node scripts/bump-version.mjs patch",
    "version:minor": "node scripts/bump-version.mjs minor",
    "version:major": "node scripts/bump-version.mjs major",
    "version:set": "node scripts/bump-version.mjs set",
    "sync:models": "node scripts/sync-models.mjs",
    "providers:catalog:check": "pnpm --filter @wrongstack/providers build && node scripts/generate-provider-catalog.mjs",
    "providers:catalog:write": "pnpm --filter @wrongstack/providers build && node scripts/generate-provider-catalog.mjs --write",
    "plugins:manifest:check": "pnpm --filter @wrongstack/plugins build && node scripts/generate-plugin-projections.mjs",
    "plugins:manifest:generate": "node scripts/generate-plugin-projections.mjs --write",
    "plugins:manifest:write": "pnpm --filter @wrongstack/plugins build && node scripts/generate-plugin-projections.mjs --write && pnpm --filter @wrongstack/plugins build",
    "lint:scripts": "bash -n scripts/install-mailbox-bridge-skills.sh",
    "check:browser": "node scripts/check-browser-runtime.mjs",
    "check:browser:smoke": "node scripts/check-browser-runtime.mjs --smoke",
    "install:browser": "node scripts/check-browser-runtime.mjs --install",
    "check:node-pty": "node scripts/check-node-pty.mjs",
    "check:clean-dist": "node scripts/check-build-lineage.mjs --assert-clean",
    "check:build-manifest": "node scripts/check-build-lineage.mjs --verify .reports/build-artifact-manifest.json",
    "write:build-manifest": "node scripts/check-build-lineage.mjs --write .reports/build-artifact-manifest.json",
    "check:architecture": "node scripts/snapshot-core-public-api.mjs && node scripts/check-architecture-health.mjs",
    "check:architecture:sync": "node scripts/snapshot-core-public-api.mjs --write && node scripts/check-architecture-health.mjs --write-hotspot-baseline --report-only",
    "check:test-inventory": "node scripts/check-test-inventory.mjs",
    "check:test-skips": "node scripts/check-test-skips.mjs",
    "check:test-types": "node scripts/check-test-typecheck.mjs",
    "report:architecture": "node scripts/check-architecture-health.mjs --write --report-only",
    "release:check": "pnpm audit --audit-level=moderate && pnpm build && pnpm providers:catalog:check && pnpm plugins:manifest:check && node scripts/check-package-contracts.mjs && pnpm write:build-manifest && pnpm check:build-manifest && pnpm check:architecture:sync && pnpm check:test-inventory && pnpm check:test-skips && pnpm check:test-types && pnpm check:node-pty && pnpm lint:i18n && pnpm typecheck && pnpm test:coverage",
    "release:dry": "pnpm publish -r --dry-run --no-git-checks --force",
    "release": "pnpm release:check && pnpm publish -r --access public --no-git-checks",
    "prepublishOnly": "pnpm test:guard",
    "test:guard": "vitest run packages/plugins/tests/catalog.test.ts packages/plugins/tests/plugin-teardown.test.ts packages/plugins/tests/smoke.test.ts",
    "setup:hooks": "git config core.hooksPath .githooks",
    "postinstall": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.2",
    "@vitest/coverage-istanbul": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@wrongstack/tools": "workspace:*",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "undici-types": "^8.9.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "dompurify": ">=3.4.11",
    "esbuild": "^0.28.1",
    "undici-types": "^8.5.0"
  }
}
