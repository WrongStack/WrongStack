{
  "name": "wrongstack-monorepo",
  "private": true,
  "version": "1.1.16",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "bun": ">=1.4.3"
  },
  "scripts": {
    "skill:route": "bun scripts/wrongstack-skill-engine.ts",
    "skill:list": "bun scripts/wrongstack-skill-engine.ts --list",
    "skill:check-bundle": "bun packages/core/skills/skill-creator/scripts/check-bundle.ts",
    "skill:check-versions": "bun packages/core/skills/tech-stack/scripts/sync-versions.mjs --check",
    "skill:sync-versions": "bun packages/core/skills/tech-stack/scripts/sync-versions.mjs --write",
    "build": "bun scripts/build.mjs",
    "build:bun": "bun scripts/build.mjs",
    "build:binaries": "bun scripts/build-binaries.mjs",
    "build:binary": "bun scripts/build-binaries.mjs --current",
    "desktop": "bun run --filter @wrongstack/desktop dev",
    "desktop:start": "bun run --filter @wrongstack/desktop start",
    "test": "bun run --filter @wrongstack/core... build && bun --bun run vitest run && bun run --filter @wrongstack/webui test",
    "test:watch": "bun --bun run vitest",
    "test:package": "bun scripts/test-package.mjs",
    "test:affected": "bun scripts/test-affected.mjs",
    "test:affected:all": "bun scripts/test-affected.mjs --all",
    "bench": "bun --bun run vitest run --config vitest.bench.config.ts",
    "bench:perf": "bun scripts/bench.mjs",
    "perf:guard": "bun scripts/perf-guard.mjs",
    "perf:guard:write": "bun scripts/perf-guard.mjs --write",
    "bench:tui-heap": "bun scripts/tui-heap-soak.mjs",
    "perf:chronicle": "bun scripts/perf-chronicle-append.mts",
    "analyze:cpuprofile": "bun scripts/analyze-cpuprofile.mjs",
    "profile:memory": "bun scripts/memory-profile.mjs",
    "analyze:memory": "bun scripts/analyze-memory-log.mjs",
    "brain:workload": "bun scripts/brain-workload-report.mjs",
    "test:coverage": "bun scripts/coverage-lock.mjs bun scripts/test-coverage.mjs",
    "test:coverage:root": "bun scripts/coverage-lock.mjs cross-env NODE_OPTIONS=--max-old-space-size=4096 bun scripts/run-vitest-coverage.mjs run --coverage",
    "test:coverage:scripts": "bun scripts/coverage-lock.mjs bun scripts/run-vitest-coverage.mjs run --config vitest.scripts.config.ts --coverage",
    "check:coverage-zero": "bun scripts/check-zero-coverage.mjs",
    "coverage:matrix": "bun scripts/coverage-matrix.mjs",
    "check:e2e": "bun --bun run playwright test",
    "test:e2e": "bun --bun run playwright test",
    "lint": "biome lint .",
    "lint:distributive": "bun scripts/lint-distributive-types.mjs",
    "lint:console": "bun scripts/lint-console-logging.mjs --all",
    "lint:i18n": "bun scripts/check-i18n-completeness.mjs",
    "lint:imports": "bun scripts/check-relative-imports.mjs",
    "format": "biome format --write .",
    "typecheck": "bun run build && bun run typecheck:only",
    "typecheck:only": "bun run --workspaces --sequential --if-present typecheck",
    "clean": "bun run --workspaces --if-present clean && bun -e \"require('node:fs').rmSync('node_modules',{recursive:true,force:true})\"",
    "version:patch": "bun scripts/bump-version.mjs patch",
    "version:minor": "bun scripts/bump-version.mjs minor",
    "version:major": "bun scripts/bump-version.mjs major",
    "version:set": "bun scripts/bump-version.mjs set",
    "sync:models": "bun scripts/sync-models.mjs",
    "sync:chatgpt-overlay": "bun scripts/sync-chatgpt-overlay.mjs",
    "providers:catalog:check": "bun run --filter @wrongstack/providers build && bun scripts/generate-provider-catalog.mjs",
    "providers:catalog:write": "bun run --filter @wrongstack/providers build && bun scripts/generate-provider-catalog.mjs --write",
    "website:tools:check": "bun run --filter @wrongstack/tools build && bun scripts/generate-website-tool-catalog.ts",
    "website:tools:write": "bun run --filter @wrongstack/tools build && bun scripts/generate-website-tool-catalog.ts --write && biome format --write website/src/data/runtime-catalog.ts website/src/data/tool-details-part-1.ts website/src/data/tool-details-part-2.ts website/src/data/tool-details-part-3.ts website/src/data/tool-details-part-4.ts",
    "plugins:manifest:check": "bun run --filter @wrongstack/plugins build && bun scripts/generate-plugin-projections.mjs",
    "plugins:manifest:generate": "bun scripts/generate-plugin-projections.mjs --write",
    "plugins:manifest:write": "bun scripts/generate-plugin-projections.mjs --bootstrap && bun run --filter @wrongstack/plugins build && bun scripts/generate-plugin-projections.mjs --write && bun run --filter @wrongstack/plugins build",
    "lint:scripts": "bash -n scripts/install-mailbox-bridge-skills.sh",
    "check:browser": "bun scripts/check-browser-runtime.mjs",
    "check:browser:smoke": "bun scripts/check-browser-runtime.mjs --smoke",
    "install:browser": "bun scripts/check-browser-runtime.mjs --install",
    "check:node-pty": "bun scripts/check-node-pty.mjs",
    "check:rulebook": "bun scripts/check-rulebook.mjs",
    "check:clean-dist": "bun scripts/check-build-lineage.mjs --assert-clean",
    "check:dist-hidden": "bun scripts/check-dist-hidden-files.mjs",
    "check:dep-paths": "bun scripts/check-dep-path-separators.mjs",
    "check:action-pins": "bun scripts/check-action-pins.mjs",
    "check:feature-matrix": "bun scripts/check-feature-matrix.mjs",
    "docs:check": "bun scripts/check-docs.mjs && bun scripts/documentation-catalog.mjs && bun scripts/check-command-docs.mjs && bun scripts/check-feature-matrix.mjs",
    "docs:catalog:write": "bun scripts/documentation-catalog.mjs --write",
    "check:lint-warnings": "bun scripts/check-lint-warnings.mjs",
    "check:build-manifest": "bun scripts/check-build-lineage.mjs --verify .reports/build-artifact-manifest.json",
    "write:build-manifest": "bun scripts/check-build-lineage.mjs --write .reports/build-artifact-manifest.json",
    "check:architecture": "bun scripts/snapshot-core-public-api.mjs && bun scripts/check-architecture-health.mjs && bun scripts/check-core-layers.mjs",
    "check:architecture:sync": "bun scripts/snapshot-core-public-api.mjs --write && bun scripts/check-architecture-health.mjs --write-hotspot-baseline --report-only && bun scripts/check-core-layers.mjs --write",
    "check:core-layers": "bun scripts/check-core-layers.mjs",
    "check:core-layers:sync": "bun scripts/check-core-layers.mjs --write",
    "check:test-inventory": "bun scripts/check-test-inventory.mjs",
    "check:test-skips": "bun scripts/check-test-skips.mjs",
    "test-skips:sync": "bun scripts/check-test-skips.mjs --print-baseline > architecture/test-skip-budget.json",
    "check:test-types": "bun scripts/check-test-typecheck.mjs",
    "setup:bun": "bun scripts/setup-bun-typecheck.mjs",
    "report:architecture": "bun scripts/check-architecture-health.mjs --write --report-only",
    "release:prepare": "bun run build && bun run providers:catalog:write && bun run plugins:manifest:write && bun run check:architecture:sync && bun run report:architecture && bun run check:architecture:strict && bun run test-skips:sync",
    "check:architecture:strict": "bun scripts/check-architecture-health.mjs --strict-hotspots",
    "release:check": "bun scripts/release-check-matrix.mjs",
    "release:fast": "bun scripts/release-check-matrix.mjs --profile release-fast",
    "release:portable:win": "bun run build && bun run smoke:bun && bun scripts/build-portable.mjs",
    "release": "bun run release:check",
    "smoke:bun": "bun scripts/smoke-bun-runtime.mjs",
    "start:bun": "bun packages/cli/dist/index.js",
    "prepublishOnly": "bun -e \"console.error('npm publishing is retired: WrongStack releases ship only as GitHub Release binaries, built by CI from a vX.Y.Z tag. Nothing in this repo may be published to npm.'); process.exit(1)\"",
    "test:guard": "bun --bun run vitest run packages/plugins/tests/catalog.test.ts packages/plugins/tests/plugin-teardown.test.ts packages/plugins/tests/smoke.test.ts",
    "ci:local": "bun scripts/release-check-matrix.mjs --profile local",
    "setup:hooks": "git config core.hooksPath .githooks",
    "setup:native": "bun scripts/rebuild-reviewed-native.mjs",
    "migration:check": "bun scripts/check-bun-migration.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-istanbul": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@wrongstack/core": "workspace:*",
    "@wrongstack/tools": "workspace:*",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "jsdom": "30.0.1",
    "postject": "1.0.0-alpha.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-language-server": "^6.0.2",
    "typescript5": "npm:typescript@5.9.3",
    "undici-types": "^8.12.3",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "website"
  ],
  "patchedDependencies": {
    "ws@8.22.0": "patches/ws@8.22.0.patch"
  },
  "trustedDependencies": [
    "electron-winstaller",
    "esbuild",
    "node-pty"
  ],
  "overrides": {
    "@electron/get@3.1.0": {
      "global-agent": "4.1.3"
    },
    "brace-expansion@<1.1.21": {
      ".": "^1.1.21"
    },
    "brace-expansion@>=2.0.0 <2.1.7": {
      ".": "^2.1.7"
    },
    "brace-expansion@>=4.0.0 <5.0.12": {
      ".": "^5.0.12"
    },
    "dompurify": ">=3.4.17",
    "fast-uri@>=3.0.0 <3.1.8": {
      ".": "^3.1.8"
    },
    "http-cache-semantics": ">=4.3.0",
    "sharp": ">=0.35.5",
    "source-map-js@<1.2.2": {
      ".": "1.2.2"
    },
    "wrongstack": "link:apps/wrongstack"
  }
}
