# ─────────────────────────────────────────────────────────────────────────
# WrongStack .env.example
#
# Copy to .env (or .env.local) and fill in the values you need.
# This file is committed to git; .env and .env.* are git-ignored.
#
# Provider API keys are typically configured interactively via:
#   wstack --add-provider
# or stored in ~/.wrongstack/profiles/<name>/config.json. Env vars below are an alternative
# for CI/headless setups.
# ─────────────────────────────────────────────────────────────────────────

# ═══════════════════════════════════════════════════════════════════════
# LLM Provider API Keys
# ═══════════════════════════════════════════════════════════════════════
# At least one provider key is required to use the agent.

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI (GPT-4, GPT-4o, Codex, etc.)
OPENAI_API_KEY=

# Google (Gemini)
GOOGLE_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# OpenRouter (meta-provider — routes to 400+ models)
OPENROUTER_API_KEY=

# Moonshot / Kimi
KIMI_API_KEY=
MOONSHOT_API_KEY=


AI_GATEWAY_API_KEY=

# ═══════════════════════════════════════════════════════════════════════
# MCP Server / Tool API Keys
# ═══════════════════════════════════════════════════════════════════════
# These are forwarded to MCP servers that declare them in passthroughEnv.

# Brave Search (web search tool)
BRAVE_SEARCH_API_KEY=

# Google Maps
GOOGLE_MAPS_API_KEY=

# ═══════════════════════════════════════════════════════════════════════
# WrongStack Runtime Configuration
# ═══════════════════════════════════════════════════════════════════════

# Override the global data directory (default: ~/.wrongstack)
# WRONGSTACK_HOME=/custom/path/to/.wrongstack

# Override the shell used by the bash tool (default: auto-detected at boot)
# WRONGSTACK_SHELL=/bin/bash
# WRONGSTACK_SHELL=cmd.exe

# Enable verbose debug output (equivalent to NODE_ENV=development for some paths)
# WRONGSTACK_DEBUG=1

# Log level: trace, debug, info, warn, error (default: info)
# WRONGSTACK_LOG_LEVEL=debug

# Log format: pretty (colored) or json (machine-parseable) (default: pretty)
# WRONGSTACK_LOG_FORMAT=json

# Debug configuration loading (prints merge order and sources)
# WRONGSTACK_DEBUG_CONFIG=1

# Forward the full parent environment to child processes (default: minimal allowlist)
# WRONGSTACK_CHILD_ENV_PASSTHROUGH=1

# Disable "did you know" launch hints
# WRONGSTACK_NO_HINTS=1

# Enable mouse support in TUI mode
# WRONGSTACK_MOUSE=1

# ═══════════════════════════════════════════════════════════════════════
# Fleet concurrency + lifetime spawn budgets (issue #323)
# ═══════════════════════════════════════════════════════════════════════
# Priority: CLI flag → env → profile config → built-in default.
# Live used/remaining values: `/fleet status` Budget block (not these env vars).

# Max concurrent subagents (default 4). Equivalent CLI: --max-concurrent <n>
# WRONGSTACK_MAX_CONCURRENT=8

# Lifetime spawn cap for a director run (default 64). Not concurrency —
# cumulative spawns across the session. Equivalent CLI: --max-spawns <n>
# Profile alternative: fleet.budget.maxSpawns
# WRONGSTACK_MAX_SPAWNS=256

# ═══════════════════════════════════════════════════════════════════════
# WebUI / E2E Testing
# ═══════════════════════════════════════════════════════════════════════

# Override the WebUI server URL for Playwright E2E tests (default: http://127.0.0.1:3456)
# WEBUI_URL=http://127.0.0.1:3456

# Path to the compiled CLI binary for E2E global-setup (default: packages/cli/dist/index.js)
# CLI_PATH=packages/cli/dist/index.js

# ═══════════════════════════════════════════════════════════════════════
# Telegram Bot (optional integration)
# ═══════════════════════════════════════════════════════════════════════
# Configured in the active profile config, not typically via env vars.

# ═══════════════════════════════════════════════════════════════════════
# Build / CI
# ═══════════════════════════════════════════════════════════════════════

# Skip .d.ts declaration generation during build (speeds up local dev)
# WRONGSTACK_SKIP_DTS=1

# Internal: set by the workspace build driver to prevent recursive builds
# WRONGSTACK_WORKSPACE_BUILD=1

# ═══════════════════════════════════════════════════════════════════════
# Terminal / Color
# ═══════════════════════════════════════════════════════════════════════

# Disable colored output
# NO_COLOR=1

# Force colored output even when not a TTY
# FORCE_COLOR=1
