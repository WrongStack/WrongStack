{
  "name": "wrongstack-website",
  "private": true,
  "version": "1.1.6",
  "type": "module",
  "scripts": {
    "dev": "bun --bun run vite",
    "build": "bun run typecheck && bun --bun run vite build",
    "typecheck": "bun ../scripts/bun-typecheck.mjs",
    "preview": "bun --bun run vite preview",
    "test": "bun --bun run vitest run",
    "typecheck:tests": "bun ../scripts/bun-typecheck.mjs --project tsconfig.tests.json",
    "format": "bun --bun run biome format --write .",
    "lint": "bun --bun run biome lint ."
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.56.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
