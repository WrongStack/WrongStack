# Local source build by default. Set this to a registry tag/digest before
# enabling the automatic image update timer.
WRONGSTACK_HQ_IMAGE=wrongstack-hq:local
WRONGSTACK_HQ_BIND_IP=0.0.0.0
WRONGSTACK_HQ_PORT=3499

# Optional exact IP/CIDR admission rules. Empty means no network allowlist.
# With Docker bridge networking, verify which peer address reaches HQ; enforce
# end-user filtering on the host firewall/proxy when Docker masks that source.
WRONGSTACK_HQ_ALLOWLIST=

# The password file is used only on first boot. Rotate the active password in
# HQ Settings; it remains authoritative on later container starts.
