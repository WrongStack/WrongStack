{
  "name": "@wrongstack/tui",
  "version": "1.1.16",
  "private": true,
  "license": "MIT",
  "description": "WrongStack terminal UI: Ink-based interactive renderer with history, pickers, and slash menus.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WrongStack/WrongStack.git",
    "directory": "packages/tui"
  },
  "homepage": "https://github.com/WrongStack/WrongStack#readme",
  "bugs": "https://github.com/WrongStack/WrongStack/issues",
  "author": "ECOSTACK TECHNOLOGY OÜ",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-package.mjs",
    "test": "bun --bun run vitest run --config vitest.config.ts",
    "test:status-bar": "bun --bun run vitest run --config vitest.status-bar-sgr.config.ts",
    "test:watch": "bun --bun run vitest --config vitest.config.ts",
    "test:coverage": "bun --bun run vitest run --coverage --config vitest.config.ts",
    "typecheck": "bun ../../scripts/bun-typecheck.mjs --noEmit && bun ../../scripts/bun-typecheck.mjs --noEmit -p tsconfig.test.json",
    "typecheck:tests": "bun ../../scripts/bun-typecheck.mjs --noEmit -p tsconfig.test.json",
    "clean": "bun -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@wrongstack/contracts": "workspace:*",
    "@wrongstack/core": "workspace:*",
    "@wrongstack/goal": "workspace:*",
    "@wrongstack/hq": "workspace:*",
    "@wrongstack/kanban": "workspace:*",
    "@wrongstack/primitives": "workspace:*",
    "@wrongstack/runtime": "workspace:*",
    "@wrongstack/sage": "workspace:*",
    "@wrongstack/sdd": "workspace:*",
    "@wrongstack/tools": "workspace:*",
    "string-width": "8.3.0",
    "wrap-ansi": "^10.0.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ink": "8.0.0",
    "ink-testing-library": "^4.0.0",
    "jsdom": "30.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
