{
  "compilerOptions": {
    "target": "ES2022",
    // ES2023 lib (not target): this project also typechecks the core sources it
    // imports, and core targets ES2024 — `Array.findLastIndex` there is invisible
    // under an ES2022 lib. Emit stays ES2022; only the API surface widens.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    // Repo-wide safety flags from tsconfig.base.json. This package cannot
    // extend that file (bundler/JSX resolution differs), so the flags are
    // mirrored here deliberately — without them the UI packages were the only
    // ones in the workspace where an out-of-range index silently typed as the
    // element type.
    // `noUncheckedIndexedAccess` is NOT on here yet: it reports 64 sites in
    // this package, which is a scoped burn-down, not a drive-by fix.
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "declaration": true,
    "declarationMap": true,
    "paths": {
      "@/*": ["./src/*"],
      "@wrongstack/project-surfaces/host": ["../project-surfaces/src/host.tsx"],
      "@wrongstack/project-surfaces/*": ["../project-surfaces/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
