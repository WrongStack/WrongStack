    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@uiw/react-textarea-code-editor": "^3.1.3",
    "@wrongstack/contracts": "workspace:*",
    "@wrongstack/core": "workspace:*",
    "@wrongstack/goal": "workspace:*",
    "@wrongstack/kanban": "workspace:*",
    "@wrongstack/plugins": "workspace:*",
    "@wrongstack/project-surfaces": "workspace:*",
    "@wrongstack/providers": "workspace:*",
    "@wrongstack/tools": "workspace:*",
    "@wrongstack/webui-protocol": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
