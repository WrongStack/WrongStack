{
  "name": "@wrongstack/webui",
  "version": "1.5.5",
  "private": true,
  "license": "MIT",
  "description": "Browser-based WebUI for WrongStack — React + Vite frontend. The WebSocket backend lives in the separate @wrongstack/webui-server package (extracted in PR #018b to remove the CLI -> @wrongstack/webui/server cross-package edge).",
  "keywords": [
    "wrongstack",
    "ai",
    "agent",
    "llm",
    "openai",
    "webui",
    "react"
  ],
  "homepage": "https://github.com/WrongStack/WrongStack#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WrongStack/WrongStack.git",
    "directory": "packages/webui"
  },
  "bugs": {
    "url": "https://github.com/WrongStack/WrongStack/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "bun --bun run vite",
    "build": "bun --bun run vite build && bun ../../scripts/build-package.mjs",
    "typecheck": "bun ../../scripts/bun-typecheck.mjs --noEmit",
    "test": "bun --bun run vitest run",
    "test:at-mention-browser": "bun tests/at-mention-browser-smoke.mjs",
    "test:user-input-browser": "bun tests/user-input-browser-smoke.mjs",
    "test:mailbox-compose-browser": "bun tests/mailbox-compose-browser-smoke.mjs",
    "test:page-scroll-browser": "bun tests/page-scroll-browser-smoke.mjs",
    "test:story-theme-browser": "bun tests/story-theme-browser-smoke.mjs",
    "test:session-sidebar-browser": "bun tests/session-sidebar-browser-smoke.mjs",
    "test:workbench-visual-browser": "bun tests/workbench-visual-browser-smoke.mjs",
    "test:kanban-startup": "bun tests/kanban-start-webui-smoke.mjs",
    "test:watch": "bun --bun run vitest",
    "test:coverage": "bun ../../scripts/coverage-lock.mjs bun ../../scripts/run-vitest-coverage.mjs run --coverage"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/cascadia-code": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-mono": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/red-hat-mono": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@fontsource-variable/source-code-pro": "^5.3.1",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource-variable/victor-mono": "^5.3.0",
    "@fontsource/commit-mono": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@fontsource/intel-one-mono": "^5.3.0",
    "@fontsource/iosevka": "^5.3.0",
