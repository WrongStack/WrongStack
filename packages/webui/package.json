    "i18next-resources-to-backend": "^1.2.4",
    "lucide-react": "^1.69.0",
    "monaco-editor": "^0.57.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "virtua": "^0.54.2",
    "zustand": "^5.0.16"
  },
  "optionalDependencies": {
    "node-pty": "1.2.0-beta.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "@wrongstack/coordination": "workspace:*",
    "@wrongstack/sdd": "workspace:*",
    "@wrongstack/webui-server": "workspace:*",
    "jsdom": "31.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.0.5"
  }
}
