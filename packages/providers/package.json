{
  "name": "@wrongstack/providers",
  "version": "1.7.0",
  "private": true,
  "license": "MIT",
  "description": "WrongStack LLM provider adapters (Anthropic, OpenAI, Google) built on declarative WireFormatConfig.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WrongStack/WrongStack.git",
    "directory": "packages/providers"
  },
  "homepage": "https://github.com/WrongStack/WrongStack#readme",
  "bugs": "https://github.com/WrongStack/WrongStack/issues",
  "author": "ECOSTACK TECHNOLOGY OÜ",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./oauth": {
      "types": "./dist/oauth/index.d.ts",
      "import": "./dist/oauth/index.js"
    },
    "./definitions": {
      "types": "./dist/provider-definitions.d.ts",
      "import": "./dist/provider-definitions.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-package.mjs",
    "typecheck": "bun ../../scripts/bun-typecheck.mjs --noEmit",
    "test": "bun --bun run vitest run --root ../.. packages/providers/tests",
    "clean": "bun -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "5.0.133",
    "@ai-sdk/anthropic": "4.0.97",
    "@ai-sdk/azure": "4.0.117",
    "@ai-sdk/cohere": "4.0.76",
    "@ai-sdk/google": "4.0.112",
    "@ai-sdk/google-vertex": "5.0.132",
    "@ai-sdk/openai": "4.0.109",
    "@ai-sdk/openai-compatible": "3.0.85",
    "@ai-sdk/provider": "4.0.36",
    "@wrongstack/contracts": "workspace:*",
    "@wrongstack/core": "workspace:*",
    "ai": "7.0.163",
    "ws": "^8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
