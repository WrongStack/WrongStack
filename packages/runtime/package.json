{
  "name": "@wrongstack/runtime",
  "version": "0.308.2",
  "license": "MIT",
  "description": "WrongStack default runtime implementations and host-level composition helpers built on @wrongstack/core.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WrongStack/WrongStack.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/WrongStack/WrongStack#readme",
  "bugs": "https://github.com/WrongStack/WrongStack/issues",
  "author": "ECOSTACK TECHNOLOGY OU",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pack": {
      "types": "./dist/pack.d.ts",
      "import": "./dist/pack.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./governance-bootstrap": {
      "types": "./dist/governance-bootstrap.d.ts",
      "import": "./dist/governance-bootstrap.js"
    },
    "./governance-sanitize": {
      "types": "./dist/governance-sanitize.d.ts",
      "import": "./dist/governance-sanitize.js"
    },
    "./governance-mutation-snapshot-bridge": {
      "types": "./dist/governance-mutation-snapshot-bridge.d.ts",
      "import": "./dist/governance-mutation-snapshot-bridge.js"
    },
    "./vision": {
      "types": "./dist/vision.d.ts",
      "import": "./dist/vision.js"
    },
    "./clipboard": {
      "types": "./dist/clipboard.d.ts",
      "import": "./dist/clipboard.js"
    },
    "./probe": {
      "types": "./dist/probe.d.ts",
      "import": "./dist/probe.js"
    },
    "./tool-registration": {
      "types": "./dist/tool-registration.d.ts",
      "import": "./dist/tool-registration.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@wrongstack/core": "workspace:*",
    "@wrongstack/governance": "workspace:*",
    "@wrongstack/sage": "workspace:*",
    "@wrongstack/tools": "workspace:*",
    "@wrongstack/vector-memory": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
