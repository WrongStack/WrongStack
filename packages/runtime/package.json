{
  "name": "@wrongstack/runtime",
  "version": "1.5.5",
  "private": true,
  "license": "MIT",
  "description": "WrongStack default runtime implementations and host-level composition helpers built on @wrongstack/core.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WrongStack/WrongStack.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/WrongStack/WrongStack#readme",
  "bugs": "https://github.com/WrongStack/WrongStack/issues",
  "author": "ECOSTACK TECHNOLOGY OU",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./chimera": {
      "types": "./dist/chimera.d.ts",
      "import": "./dist/chimera.js"
    },
    "./commands": {
      "types": "./dist/commands.d.ts",
      "import": "./dist/commands.js"
    },
    "./pack": {
      "types": "./dist/pack.d.ts",
      "import": "./dist/pack.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./governance-bootstrap": {
      "types": "./dist/governance-bootstrap.d.ts",
      "import": "./dist/governance-bootstrap.js"
    },
    "./governance-sanitize": {
      "types": "./dist/governance-sanitize.d.ts",
      "import": "./dist/governance-sanitize.js"
    },
    "./governance-mutation-snapshot-bridge": {
      "types": "./dist/governance-mutation-snapshot-bridge.d.ts",
      "import": "./dist/governance-mutation-snapshot-bridge.js"
    },
    "./vision": {
      "types": "./dist/vision.d.ts",
      "import": "./dist/vision.js"
    },
    "./clipboard": {
      "types": "./dist/clipboard.d.ts",
      "import": "./dist/clipboard.js"
    },
    "./probe": {
      "types": "./dist/probe.d.ts",
      "import": "./dist/probe.js"
    },
    "./tool-registration": {
      "types": "./dist/tool-registration.d.ts",
      "import": "./dist/tool-registration.js"
    },
    "./provider-utility-tools": {
      "types": "./dist/provider-utility-tools.d.ts",
      "import": "./dist/provider-utility-tools.js"
    },
    "./system-prompt-contributors": {
      "types": "./dist/system-prompt-contributors.d.ts",
      "import": "./dist/system-prompt-contributors.js"
    },
    "./package.json": "./package.json",
    "./jev-checks": {
      "types": "./dist/jev-checks.d.ts",
      "import": "./dist/jev-checks.js"
    },
    "./plugin-host": {
      "types": "./dist/plugin-host.d.ts",
      "import": "./dist/plugin-host.js"
    },
    "./dep-watcher": {
      "types": "./dist/dep-watcher.d.ts",
      "import": "./dist/dep-watcher.js"
    },
    "./prompt-journal": {
      "types": "./dist/prompt-journal.d.ts",
      "import": "./dist/prompt-journal.js"
    },
    "./hq-host": {
      "types": "./dist/hq-host.d.ts",
      "import": "./dist/hq-host.js"
    },
    "./acp-leader": {
      "types": "./dist/acp-leader.d.ts",
      "import": "./dist/acp-leader.js"
    },
    "./acp-leader-host": {
      "types": "./dist/acp-leader-host.d.ts",
      "import": "./dist/acp-leader-host.js"
    },
    "./plugin-management": {
      "types": "./dist/plugin-management.d.ts",
      "import": "./dist/plugin-management.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-package.mjs",
    "typecheck": "bun ../../scripts/bun-typecheck.mjs --noEmit",
    "test": "bun --bun run vitest run --config vitest.config.ts",
    "clean": "bun -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@wrongstack/acp": "workspace:*",
    "@wrongstack/agent-catalog": "workspace:*",
    "@wrongstack/builtin-plugins": "workspace:*",
    "@wrongstack/chronicle": "workspace:*",
    "@wrongstack/contracts": "workspace:*",
    "@wrongstack/coordination": "workspace:*",
    "@wrongstack/core": "workspace:*",
    "@wrongstack/fleet": "workspace:*",
    "@wrongstack/governance": "workspace:*",
    "@wrongstack/hq": "workspace:*",
    "@wrongstack/kanban": "workspace:*",
    "@wrongstack/mcp": "workspace:*",
    "@wrongstack/plug-lsp": "workspace:*",
    "@wrongstack/plugins": "workspace:*",
    "@wrongstack/primitives": "workspace:*",
    "@wrongstack/sage": "workspace:*",
    "@wrongstack/security-scanner": "workspace:*",
    "@wrongstack/telegram": "workspace:*",
    "@wrongstack/tools": "workspace:*",
    "@wrongstack/vector-memory": "workspace:*",
    "@wrongstack/webui-protocol": "workspace:*",
    "@wrongstack/wrongtrace": "workspace:*",
    "cron-parser": "^5.10.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
