{
  "name": "@wrongstack/acp",
  "version": "1.1.16",
  "private": true,
  "license": "MIT",
  "description": "ACP (Agent Client Protocol) integration for WrongStack — client + agent support",
  "keywords": [
    "ai",
    "agent",
    "acp",
    "agent-client-protocol",
    "coding-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WrongStack/WrongStack.git",
    "directory": "packages/acp"
  },
  "homepage": "https://github.com/WrongStack/WrongStack#readme",
  "bugs": "https://github.com/WrongStack/WrongStack/issues",
  "author": "ECOSTACK TECHNOLOGY OÜ",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    },
    "./agent": {
      "import": "./dist/agent.js",
      "types": "./dist/agent.d.ts"
    },
    "./sdk": {
      "import": "./dist/sdk.js",
      "types": "./dist/sdk.d.ts"
    },
    "./v1": {
      "import": "./dist/v1.js",
      "types": "./dist/v1.d.ts"
    },
    "./legacy": {
      "import": "./dist/legacy.js",
      "types": "./dist/legacy.d.ts"
    },
    "./sdk/unstable": {
      "import": "./dist/sdk-unstable.js",
      "types": "./dist/sdk-unstable.d.ts"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-package.mjs",
    "typecheck": "bun ../../scripts/bun-typecheck.mjs --noEmit",
    "typecheck:tests": "bun ../../scripts/bun-typecheck.mjs --noEmit -p tsconfig.test.json",
    "clean": "bun -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "bun --bun run vitest run",
    "smoke": "bun run build && bun ../../scripts/acp-smoke-test.mts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.0.0",
    "@wrongstack/contracts": "workspace:*",
    "@wrongstack/core": "workspace:*",
    "@wrongstack/primitives": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
