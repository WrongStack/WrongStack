{
  "name": "@wrongstack/webui-protocol",
  "version": "1.0.37",
  "license": "MIT",
  "description": "Wire-protocol contracts shared between the @wrongstack/webui + @wrongstack/simpleui frontends and the @wrongstack/webui-server backend. Browser-safe: depends only on @wrongstack/core types (no ws, no node-only APIs). Extracted in 2026-08 to remove the webui/simpleui -> webui-server transitive dependency (see docs/archive/reports/modularity-assessment-2026-08-22.md §2.2).",
  "keywords": [
    "wrongstack",
    "webui",
    "websocket",
    "protocol"
  ],
  "homepage": "https://github.com/WrongStack/WrongStack#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WrongStack/WrongStack.git",
    "directory": "packages/webui-protocol"
  },
  "bugs": {
    "url": "https://github.com/WrongStack/WrongStack/issues"
  },
  "author": "ECOSTACK TECHNOLOGY OÜ",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./frame-resume": {
      "types": "./dist/frame-resume.d.ts",
      "import": "./dist/frame-resume.js"
    },
    "./schema/ws-core.schema.json": "./schema/ws-core.schema.json",
    "./schema/openapi.json": "./schema/openapi.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "schema"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-package.mjs",
    "typecheck": "bun ../../scripts/bun-typecheck.mjs --noEmit",
    "schema": "bun ../../scripts/generate-protocol-schema.mjs",
    "test": "bun --bun run vitest run",
    "test:coverage": "bun ../../scripts/coverage-lock.mjs bun ../../scripts/run-vitest-coverage.mjs run --coverage --config vitest.config.ts",
    "clean": "bun -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@wrongstack/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "ajv": "^8.20.0",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
