{
  "name": "@wrongstack/hq-next",
  "version": "1.7.0",
  "private": true,
  "description": "WrongStack HQ command center rebuilt on the Next.js App Router as a static export served by the HQ server.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md"
  ],
  "exports": {
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun --bun next dev --hostname 127.0.0.1 --port 5174",
    "build": "bun --bun next build --webpack && bun build-package.mjs",
    "typecheck": "bun ../../scripts/bun-typecheck.mjs --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@wrongstack/contracts": "workspace:*",
    "@wrongstack/coordination": "workspace:*",
    "@wrongstack/hq": "workspace:*",
    "@wrongstack/tools": "workspace:*",
    "@wrongstack/webui-protocol": "workspace:*",
    "@xyflow/react": "12.12.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.69.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "virtua": "0.54.2",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/qrcode": "1.5.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "31.0.0",
    "next": "16.4.5",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "typescript": "^7.0.2"
  }
}
