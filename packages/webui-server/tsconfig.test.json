{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "paths": {
      "@wrongstack/project-surfaces/host": ["../project-surfaces/src/host.tsx"],
      "@wrongstack/project-surfaces/sage": ["../project-surfaces/src/sage/index.ts"],
      "@wrongstack/project-surfaces/*": ["../project-surfaces/src/*"]
    },
    "allowImportingTsExtensions": true,
    "rootDir": "../..",
    "types": ["node", "vitest"],
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*", "tests/**/*", "vitest.config.ts", "../../vitest.workers.ts"],
  "exclude": ["dist", "node_modules", "tests/fixtures/**/*"]
}
