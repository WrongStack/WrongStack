{
  "name": "@wrongstack/webui-server",
  "version": "0.320.1",
  "license": "MIT",
  "description": "WrongStack WebUI HTTP/WebSocket server module — extracted from @wrongstack/webui in PR #243/244 to remove the CLI -> @wrongstack/webui/server cross-package edge (audit §3.1.1). Pure backend: HTTP routes, WebSocket handlers, MCP tool wrappers, HTML serving. The web frontend lives in @wrongstack/webui; this package is the standalone server it can run on.",
  "keywords": [
    "wrongstack",
    "webui",
    "websocket",
    "http"
  ],
  "homepage": "https://github.com/WrongStack/WrongStack#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WrongStack/WrongStack.git",
    "directory": "packages/webui-server"
  },
  "bugs": {
    "url": "https://github.com/WrongStack/WrongStack/issues"
  },
  "author": "ECOSTACK TECHNOLOGY OÜ",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@wrongstack/core": "workspace:*",
    "@wrongstack/kanban": "workspace:*",
    "@wrongstack/mcp": "workspace:*",
    "@wrongstack/primitives": "workspace:*",
    "@wrongstack/providers": "workspace:*",
    "@wrongstack/requirement-intake": "workspace:*",
    "@wrongstack/runtime": "workspace:*",
    "@wrongstack/sdd": "workspace:*",
    "@wrongstack/sage": "workspace:*",
    "@wrongstack/techstack": "workspace:*",
    "@wrongstack/tools": "workspace:*",
    "@wrongstack/vector-memory": "workspace:*",
    "@wrongstack/webui-protocol": "workspace:*",
    "@wrongstack/wrongtrace": "workspace:*",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
