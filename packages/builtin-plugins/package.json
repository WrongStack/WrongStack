{
  "name": "@wrongstack/builtin-plugins",
  "version": "1.6.0",
  "private": true,
  "license": "MIT",
  "description": "Built-in WrongStack plugins: chimera and auto-review with their finding, report and claim stores, skills, prompts, sync, cloud-config sync and specialist triggers. Built on @wrongstack/core.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WrongStack/WrongStack.git",
    "directory": "packages/builtin-plugins"
  },
  "homepage": "https://github.com/WrongStack/WrongStack#readme",
  "bugs": {
    "url": "https://github.com/WrongStack/WrongStack/issues"
  },
  "author": "ECOSTACK TECHNOLOGY OÜ",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-package.mjs",
    "typecheck": "bun ../../scripts/bun-typecheck.mjs --noEmit",
    "clean": "bun -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@wrongstack/contracts": "workspace:*",
    "@wrongstack/core": "workspace:*",
    "@wrongstack/kanban": "workspace:*",
    "@wrongstack/primitives": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@wrongstack/coordination": "workspace:*",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
