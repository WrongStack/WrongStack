{
  "name": "@wrongstack/client",
  "version": "1.0.37",
  "license": "MIT",
  "description": "Typed client for a running WrongStack WebUI server: open sessions, send prompts, stream the run and answer tool confirmations over the WebSocket protocol, and read live sessions over the HTTP API. No runtime dependencies; works in Node 22+ and the browser.",
  "keywords": [
    "wrongstack",
    "sdk",
    "client",
    "websocket",
    "agent"
  ],
  "homepage": "https://github.com/WrongStack/WrongStack#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WrongStack/WrongStack.git",
    "directory": "packages/client"
  },
  "bugs": {
    "url": "https://github.com/WrongStack/WrongStack/issues"
  },
  "author": "ECOSTACK TECHNOLOGY OÜ",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.mjs",
    "typecheck": "bun ../../scripts/bun-typecheck.mjs --noEmit",
    "test": "bun --bun run vitest run",
    "clean": "bun -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@wrongstack/webui-protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "ws": "^8.21.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
