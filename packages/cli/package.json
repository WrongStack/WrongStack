{
  "name": "@wrongstack/cli",
  "version": "0.316.0",
  "license": "MIT",
  "description": "WrongStack CLI — terminal AI coding agent with provider catalog from models.dev. Provides `wrongstack` and `wstack` binaries.",
  "keywords": [
    "ai",
    "agent",
    "cli",
    "llm",
    "anthropic",
    "openai",
    "gemini",
    "coding-agent",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WrongStack/WrongStack.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/WrongStack/WrongStack#readme",
  "bugs": "https://github.com/WrongStack/WrongStack/issues",
  "author": "ECOSTACK TECHNOLOGY OÜ",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "wstack": "./dist/index.js",
    "wrongstack": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "data"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "typecheck": "pnpm --filter @wrongstack/tools run build && pnpm --filter @wrongstack/tui run build && tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:hqdash": "vitest run --config vitest.hqdash.config.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@wrongstack/acp": "workspace:*",
    "@wrongstack/bench": "workspace:*",
    "@wrongstack/core": "workspace:*",
    "@wrongstack/primitives": "workspace:*",
    "@wrongstack/kanban": "workspace:*",
    "@wrongstack/mcp": "workspace:*",
    "@wrongstack/persistence": "workspace:*",
    "@wrongstack/plug-lsp": "workspace:*",
    "@wrongstack/plugins": "workspace:*",
    "@wrongstack/providers": "workspace:*",
    "@wrongstack/requirement-intake": "workspace:*",
    "@wrongstack/runtime": "workspace:*",
    "@wrongstack/sage": "workspace:*",
    "@wrongstack/sdd": "workspace:*",
    "@wrongstack/security-scanner": "workspace:*",
    "@wrongstack/simpleui": "workspace:*",
    "@wrongstack/techstack": "workspace:*",
    "@wrongstack/telegram": "workspace:*",
    "@wrongstack/tools": "workspace:*",
    "@wrongstack/tui": "workspace:*",
    "@wrongstack/vector-memory": "workspace:*",
    "@wrongstack/webui": "workspace:*",
    "@wrongstack/webui-hq": "workspace:*",
    "@wrongstack/webui-protocol": "workspace:*",
    "@wrongstack/wrongtrace": "workspace:*",
    "@wrongstack/webui-server": "workspace:*",
    "ws": "^8.21.3"
  },
  "optionalDependencies": {
    "@wrongstack/desktop": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
