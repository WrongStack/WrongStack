{
  "name": "@wrongstack/core",
  "version": "0.309.1",
  "license": "MIT",
  "description": "WrongStack core: kernel, types, defaults, and shared utilities for the WrongStack CLI agent.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WrongStack/WrongStack.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/WrongStack/WrongStack#readme",
  "bugs": "https://github.com/WrongStack/WrongStack/issues",
  "author": "ECOSTACK TECHNOLOGY OÜ",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./kernel": {
      "types": "./dist/kernel/index.d.ts",
      "import": "./dist/kernel/index.js"
    },
    "./agent": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./agent-catalog": {
      "types": "./dist/coordination/agents/index.d.ts",
      "import": "./dist/coordination/agents/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./types/session-markers": {
      "types": "./dist/types/session-markers.d.ts",
      "import": "./dist/types/session-markers.js"
    },
    "./core/model-ref": {
      "types": "./dist/core/model-ref.d.ts",
      "import": "./dist/core/model-ref.js"
    },
    "./defaults": {
      "types": "./dist/defaults/index.d.ts",
      "import": "./dist/defaults/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./utils/expect-defined": {
      "types": "./dist/utils/expect-defined.d.ts",
      "import": "./dist/utils/expect-defined.js"
    },
    "./utils/sage-output-block": {
      "types": "./dist/utils/sage-output-block.d.ts",
      "import": "./dist/utils/sage-output-block.js"
    },
    "./utils/error": {
      "types": "./dist/utils/error.d.ts",
      "import": "./dist/utils/error.js"
    },
    "./utils/tree-kill": {
      "types": "./dist/utils/tree-kill.d.ts",
      "import": "./dist/utils/tree-kill.js"
    },
    "./execution": {
      "types": "./dist/execution/index.d.ts",
      "import": "./dist/execution/index.js"
    },
    "./design": {
      "types": "./dist/design/index.d.ts",
      "import": "./dist/design/index.js"
    },
    "./coordination": {
      "types": "./dist/coordination/index.d.ts",
      "import": "./dist/coordination/index.js"
    },
    "./registry": {
      "types": "./dist/registry/index.d.ts",
      "import": "./dist/registry/index.js"
    },
    "./extension": {
      "types": "./dist/extension/index.d.ts",
      "import": "./dist/extension/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js",
      "require": "./dist/storage/index.js"
    },
    "./session-catalog": {
      "types": "./dist/session-catalog/index.d.ts",
      "import": "./dist/session-catalog/index.js"
    },
    "./security": {
      "types": "./dist/security/index.d.ts",
      "import": "./dist/security/index.js"
    },
    "./infrastructure": {
      "types": "./dist/infrastructure/index.d.ts",
      "import": "./dist/infrastructure/index.js"
    },
    "./models": {
      "types": "./dist/models/index.d.ts",
      "import": "./dist/models/index.js"
    },
    "./observability": {
      "types": "./dist/observability/index.d.ts",
      "import": "./dist/observability/index.js"
    },
    "./hq": {
      "types": "./dist/hq/index.d.ts",
      "import": "./dist/hq/index.js"
    },
    "./hq/protocol": {
      "types": "./dist/hq/protocol.d.ts",
      "import": "./dist/hq/protocol.js"
    },
    "./notifications": {
      "types": "./dist/notifications/index.d.ts",
      "import": "./dist/notifications/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    },
    "./skills": {
      "types": "./dist/skills/index.d.ts",
      "import": "./dist/skills/index.js"
    },
    "./package.json": "./package.json",
    "./skills/*": "./skills/*",
    "./design-kits/*": "./design-kits/*",
    "./instructions/*": "./instructions/*",
    "./data/*": "./data/*",
    "./tasking": {
      "types": "./dist/tasking/index.d.ts",
      "import": "./dist/tasking/index.js"
    },
    "./prompts": {
      "types": "./dist/prompts/index.d.ts",
      "import": "./dist/prompts/index.js"
    },
    "./chronicle": {
      "types": "./dist/chronicle/index.d.ts",
      "import": "./dist/chronicle/index.js"
    },
    "./worktree": {
      "types": "./dist/worktree/index.d.ts",
      "import": "./dist/worktree/index.js"
    },
    "./goal": {
      "types": "./dist/goal/index.d.ts",
      "import": "./dist/goal/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    },
    "./replay": {
      "types": "./dist/replay/index.d.ts",
      "import": "./dist/replay/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "skills",
    "design-kits",
    "instructions",
    "data"
  ],
  "wrongstackApiVersion": "0.1.10",
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "build:prompts": "node scripts/build-prompts.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --root ../.. packages/core/tests",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@wrongstack/kanban": "workspace:*",
    "@wrongstack/persistence": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "@datadog/pprof": "5.18.1"
  }
}
