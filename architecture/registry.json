{
  "schemaVersion": 1,
  "scope": {
    "workspaceRoots": ["packages", "apps"],
    "excludedPaths": ["website"]
  },
  "sourceExtensions": [".ts", ".tsx", ".mts", ".cts", ".js", ".jsx", ".mjs", ".cjs"],
  "coreAreas": {
    "chronicle": { "classification": "feature", "targetOwner": "core-review-required" },
    "coordination": { "classification": "feature-runtime", "targetOwner": "coordination" },
    "core": { "classification": "agent-domain", "targetOwner": "core" },
    "design": { "classification": "product-feature", "targetOwner": "core-focused-facade" },
    "execution": {
      "classification": "application-runtime",
      "targetOwner": "runtime-review-required"
    },
    "extension": { "classification": "contract", "targetOwner": "core" },
    "goal": { "classification": "feature", "targetOwner": "core-review-required" },
    "hooks": { "classification": "extension-runtime", "targetOwner": "core-review-required" },
    "hq": { "classification": "feature-runtime", "targetOwner": "hq" },
    "infrastructure": { "classification": "primitive", "targetOwner": "core" },
    "kernel": { "classification": "primitive", "targetOwner": "core" },
    "models": { "classification": "agent-domain", "targetOwner": "core" },
    "notifications": {
      "classification": "feature-runtime",
      "targetOwner": "runtime-review-required"
    },
    "observability": { "classification": "infrastructure", "targetOwner": "runtime-pilot" },
    "performance": { "classification": "infrastructure", "targetOwner": "runtime-review-required" },
    "plugin": { "classification": "contract-and-loader", "targetOwner": "contracts-or-core" },
    "plugins": { "classification": "product-feature", "targetOwner": "plugins" },
    "prompts": { "classification": "feature", "targetOwner": "core-review-required" },
    "registry": { "classification": "agent-domain", "targetOwner": "core" },
    "replay": { "classification": "feature-runtime", "targetOwner": "runtime-review-required" },
    "security": { "classification": "agent-domain", "targetOwner": "core" },
    "session-catalog": {
      "classification": "persistence-runtime",
      "targetOwner": "session-catalog"
    },
    "skills": { "classification": "feature-runtime", "targetOwner": "skills" },
    "statusline": { "classification": "feature-runtime", "targetOwner": "runtime-review-required" },
    "storage": { "classification": "persistence-runtime", "targetOwner": "storage" },
    "tasking": { "classification": "agent-domain", "targetOwner": "core-review-required" },
    "tools": { "classification": "product-feature", "targetOwner": "tools" },
    "types": { "classification": "contract", "targetOwner": "contracts-or-core" },
    "utils": { "classification": "primitive-review-required", "targetOwner": "contracts-or-core" },
    "wiring": { "classification": "infrastructure", "targetOwner": "runtime-review-required" },
    "worktree": { "classification": "host-runtime", "targetOwner": "runtime-review-required" }
  },
  "testProjects": [
    {
      "id": "webui-jsdom",
      "config": "packages/webui/vitest.config.ts",
      "cwd": "packages/webui",
      "includePrefixes": ["packages/webui/tests/"]
    },
    {
      "id": "cli-hq-jsdom",
      "config": "packages/cli/vitest.hqdash.config.ts",
      "cwd": "packages/cli",
      "exactFiles": ["packages/cli/tests/hq-dashboard.test.ts"]
    },
    {
      "id": "root-node",
      "config": "vitest.config.ts",
      "cwd": ".",
      "includePrefixes": ["packages/", "apps/"],
      "excludePrefixes": ["packages/webui/tests/"],
      "excludeFiles": ["packages/cli/tests/hq-dashboard.test.ts", "packages/tui/tests/status-bar-sgr.test.ts"]
    },
    {
      "id": "tui-status-bar-sgr",
      "config": "packages/tui/vitest.status-bar-sgr.config.ts",
      "cwd": "packages/tui",
      "exactFiles": ["packages/tui/tests/status-bar-sgr.test.ts"]
    }
  ]
}
