#!/bin/sh
# .githooks/pre-push
# Blocks `git push` unless the local CI matrix passes.
#
# Laptop equivalent of .github/workflows/ci.yml: lint, build, typecheck,
# tests, and the snapshot/architecture gates. Coverage (≈45m) and Playwright
# e2e stay in GitHub CI.
#
# Skip:                    WRONGSTACK_SKIP_PRE_PUSH=1
# Full release:check:      WRONGSTACK_PRE_PUSH_PROFILE=release
# Emergencies only:        git push --no-verify
#
# `set -e` is load-bearing: without it a failed gate would still push.
set -e

if [ -n "${WRONGSTACK_SKIP_PRE_PUSH-}" ]; then
  echo "pre-push: skipped (WRONGSTACK_SKIP_PRE_PUSH is set)"
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"

ZERO=0000000000000000000000000000000000000000
need_ci=0
saw_ref=0
docs_only=1
pushed_shas=""

# Paths that cannot break runtime / CI. A push that only touches these
# still goes through GitHub CI; locally we skip the 10–20 minute matrix.
is_docs_path() {
  case "$1" in
    *.md|*.markdown|*.txt)
      return 0
      ;;
    docs|docs/*)
      return 0
      ;;
    LICENSE|CODE_OF_CONDUCT.md|.github/*.md)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

range_is_docs_only() {
  files=$(git diff --name-only "$1" "$2")
  if [ -z "$files" ]; then
    return 0
  fi
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    if ! is_docs_path "$f"; then
      return 1
    fi
  done <<EOF
$files
EOF
  return 0
}

while read -r local_ref local_sha remote_ref remote_sha; do
  saw_ref=1
  if [ "$local_sha" = "$ZERO" ]; then
    # Remote ref delete — nothing to test.
    continue
  fi
  pushed_shas="$pushed_shas $local_sha"

  if [ "$remote_sha" = "$ZERO" ]; then
    if git rev-parse --verify --quiet origin/main >/dev/null; then
      mb=$(git merge-base origin/main "$local_sha" 2>/dev/null || true)
    else
      mb=
    fi
    if [ -n "$mb" ]; then
      from=$mb
    else
      from=$(git hash-object -t tree /dev/null)
    fi
    to=$local_sha
  else
    from=$remote_sha
    to=$local_sha
  fi

  if ! range_is_docs_only "$from" "$to"; then
    docs_only=0
    need_ci=1
  fi
done

if [ "$saw_ref" -eq 0 ]; then
  # Git didn't list refs (unusual). Fail closed: run the matrix.
  need_ci=1
  docs_only=0
fi

if [ "$need_ci" -eq 0 ]; then
  echo "pre-push: docs-only (or delete-only) push — local CI skipped"
  exit 0
fi

head=$(git rev-parse HEAD)
profile="${WRONGSTACK_PRE_PUSH_PROFILE:-local}"
stamp_dir=.reports
stamp_file=$stamp_dir/local-ci.stamp

# The matrix always runs against the worktree at HEAD. Uncommitted fixes
# would make it green while the SHA being pushed still fails; a checkout
# that is not the pushed SHA would test the wrong tree.
if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "pre-push: refusing dirty worktree — commit or stash so CI tests $head"
  exit 1
fi
if [ -n "$pushed_shas" ]; then
  for sha in $pushed_shas; do
    if [ "$sha" != "$head" ]; then
      echo "pre-push: pushing $sha but HEAD is $head — checkout the branch you are pushing"
      exit 1
    fi
  done
fi

if [ -f "$stamp_file" ] && git diff --quiet && git diff --cached --quiet; then
  stamp_sha=$(sed -n '1p' "$stamp_file")
  stamp_profile=$(sed -n '2p' "$stamp_file")
  if [ "$stamp_sha" = "$head" ] && [ "$stamp_profile" = "$profile" ]; then
    echo "pre-push: $head already passed local CI (profile=$profile) — skipped"
    exit 0
  fi
fi

export NODE_OPTIONS="${NODE_OPTIONS:---max-old-space-size=4096}"

echo "pre-push: running local CI (profile=$profile) against $head"
echo "pre-push: skip with WRONGSTACK_SKIP_PRE_PUSH=1 or git push --no-verify"
echo

node scripts/release-check-matrix.mjs --profile "$profile"

# Stamp only a clean HEAD. A green run with uncommitted fixes must not
# let a later clean re-push of the same SHA skip the matrix.
if git diff --quiet && git diff --cached --quiet; then
  mkdir -p "$stamp_dir"
  printf '%s\n%s\n' "$head" "$profile" >"$stamp_file"
fi
echo "pre-push: local CI passed — push continuing"
