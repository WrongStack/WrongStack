#!/bin/sh
# .githooks/pre-commit
# Guards against known corruption patterns and suspicious mass-changes.
#
# `set -e` is load-bearing: without it (and with the trailing `exit 0`)
# every guard below is advisory-only — failures print but never block
# the commit, which is how broken commits kept reaching main/CI.
set -e
node scripts/guard-against-corruption.mjs --verbose
node scripts/lint-console-logging.mjs --verbose

# Block commits whose staged TS files import a module that exists on
# disk but is not tracked/staged ("import committed, file forgotten").
# Local builds pass, CI's Build step fails with esbuild "Could not
# resolve" — this exact class broke every CI run after 9290b3b14.
node scripts/guard-unresolved-imports.mjs --verbose

# Core API snapshots are committed architecture evidence. Refresh and stage
# them whenever a staged source change can affect them. The helper refuses to
# run if the shared worktree has unstaged/untracked snapshot inputs, avoiding a
# generated file that accidentally includes a teammate's WIP.
node scripts/sync-core-public-api-snapshot.mjs

# Architecture measurements are committed evidence, not a manual release
# chore. When staged production/architecture inputs move, refresh the hotspot
# ratchet and report pair before the commit is created so release checks never
# fail merely because generated evidence lagged the source change.
architecture_staged=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^(packages/|apps/|architecture/|scripts/(check-architecture-health|snapshot-core-public-api|sync-core-public-api-snapshot)\.mjs$)' || true)
if [ -n "$architecture_staged" ]; then
  node scripts/check-architecture-health.mjs --write-hotspot-baseline
  pnpm report:architecture
  git add architecture/hotspots.json architecture/test-only-exports.json \
    docs/reports/architecture-health-current.json docs/reports/architecture-health-current.md
fi

# ── Mailbox-bridge integrity ─────────────────────────────────────
# If any mailbox-bridge source file is staged, run the route-table +
# source-union guard. Cheap to skip when nothing relevant is staged.
# After the canonical router extraction, this includes
# packages/core/src/coordination/mailbox-http-router.ts alongside the
# existing bridge / types / subcommand-index files.
mb_staged=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^packages/(cli/src/subcommands/(handlers/mailbox-serve\.ts|index\.ts)|core/src/(coordination/(mailbox-(types|http-router)|index)|hq/protocol))\.ts$' || true)
if [ -n "$mb_staged" ]; then
  node scripts/guard-mailbox-bridge.mjs --verbose
fi

# ── Mailbox-bridge install-helper script guard ──────────────────
# If the bash script that copies the bundled wrongstack-mailbox/SKILL.md
# into a target agent's skills directory is being modified or deleted,
# run the script-specific guard. Catches the install helper losing
# `set -e`, the wrong shebang, or the path to the bundled skill
# drifting out of sync.
mb_script_staged=$(git diff --cached --name-only --diff-filter=ADM | grep -E '^scripts/install-mailbox-bridge-skills\.sh$' || true)
if [ -n "$mb_script_staged" ]; then
  node scripts/guard-mailbox-bridge-scripts.mjs --verbose
fi

# ── Typecheck gate ───────────────────────────────────────────────────
# Workspace-wide `tsc --noEmit` is intentionally NOT run here.
#
# Rationale: `tsc --noEmit` is whole-project — it sees staged,
# unstaged, AND untracked files. If a peer is mid-edit on a
# separate feature branch's WIP (untracked or unstaged in the same
# working tree), a syntax error or TS7006 in that WIP would block
# this commit, forcing `git commit --no-verify` and silently
# skipping the typecheck. That's the exact failure mode the hook
# was meant to prevent.
#
# Instead, the typecheck gate lives in CI (.github/workflows/ci.yml
# step "Typecheck") where there's a clean checkout with no
# unrelated local edits. The new `pnpm check:node-pty` smoke
# check (added in 2c9f2a9c) is a separate fast gate that runs
# locally to catch the install-time regressions — but it's a
# single-purpose script, not a full tsc.
#
# This keeps pre-commit under ~5s and removes the only legitimate
# reason for `--no-verify` in this repo.
exit 0
